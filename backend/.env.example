# Copie este arquivo para backend/.env e preencha com os dados passados pelo time.
# O .env vale para os quatro servicos e nao vai para o git.

# Banco (Supabase): Connect > Session pooler, no formato JDBC.
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Assina o login no ms-usuarios e e conferida no api-gateway. Minimo de 32 caracteres.
API_SECURITY_TOKEN_SECRET=
